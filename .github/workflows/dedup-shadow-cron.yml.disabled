name: Dedup shadow leads (gộp bản trùng email/kênh → dòng có ID)

on:
  schedule:
    # 2 lần/ngày (đổi từ hourly 2026-08-15 — Supabase project bị khoá vì vượt
    # egress quota: job này full-scan tới 90k dòng dim_lead 2-3 LẦN mỗi lần chạy).
    # Cam kết "tự lành trong ≤1h" (dedup pid/SĐT/gmail trùng, chống đếm đôi Hot)
    # nới thành "trước mỗi report" — chấp nhận được vì report Lark chỉ bắn 2
    # lần/ngày (10:30 & 17:00 VN) và không ai xem dashboard ngoài giờ đó. Canh
    # chạy NGAY TRƯỚC mỗi report (lệch 10' sau lead-first-chat cùng giờ, tránh
    # 2 job đụng Supabase cùng lúc):
    #   02:55 UTC = 09:55 VN (35' trước report Sáng 10:30)
    #   08:55 UTC = 15:55 VN (65' trước report Chiều 17:00)
    - cron: '55 2,8 * * *'
  workflow_dispatch:

concurrency:
  group: dedup-shadow
  cancel-in-progress: false

jobs:
  dedup-shadow:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'
      - name: Install dependencies
        run: npm install --no-audit --no-fund --prefer-offline
      - name: Dedup shadow leads
        env:
          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
          SUPABASE_SECRET_KEY: ${{ secrets.SUPABASE_SECRET_KEY }}
          LARK_APP_ID: ${{ secrets.LARK_APP_ID }}
          LARK_APP_SECRET: ${{ secrets.LARK_APP_SECRET }}
          LARK_BASE_APP_TOKEN: ${{ secrets.LARK_BASE_APP_TOKEN }}
        run: npm run etl:dedup:shadow
