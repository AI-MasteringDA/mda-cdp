name: SMAX incremental sync

on:
  schedule:
    # Every ~7 minutes, nhưng CHỈ trong khung 8AM-6PM VN (2026-08-15 — Supabase
    # bị khoá vì vượt egress quota; không ai xem dashboard lúc nửa đêm nên tắt
    # hẳn ngoài giờ làm việc thay vì chỉ giãn nhịp — cắt ~58% số lần chạy/ngày
    # mà freshness giờ làm việc không đổi). 1-10 UTC = 8AM-6PM VN, dư 2.5h
    # trước report Sáng (10:30) và phủ hết report Chiều (17:00).
    # REMINDER: cron-job.org trigger phải đổi theo (chỉ bắn trong khung này),
    # nó mới là driver thật của cadence, native schedule chỉ là fallback dự phòng.
    - cron: '*/7 1-10 * * *'
  # Allow manual trigger from GitHub UI
  workflow_dispatch:

# Concurrency lock: SMAX ETL runs 4-5 min. If it ever exceeds 5 min (SMAX API
# slow / retries), don't spawn a second parallel run — queue it instead.
concurrency:
  group: smax-etl
  cancel-in-progress: false

jobs:
  smax-etl:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install dependencies
        run: npm install --no-audit --no-fund --prefer-offline

      - name: Run SMAX ETL (incremental)
        env:
          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
          SUPABASE_SECRET_KEY: ${{ secrets.SUPABASE_SECRET_KEY }}
          SMAX_USER_TOKEN: ${{ secrets.SMAX_USER_TOKEN }}
          SMAX_API_KEY: ${{ secrets.SMAX_API_KEY }}
          SMAX_BASE_URL: https://api.smax.ai
        run: npm run etl:smax:real
